# ==========================================================
# Wapply — variáveis de ambiente
# Copie este arquivo para `.env` e ajuste os valores.
#   cp .env.example .env
# ==========================================================

# ----------------------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# ----------------------------------------------------------
# Se você subiu o Postgres com `docker compose up -d`, use exatamente esta URL:
DATABASE_URL="postgresql://wapply:wapply@localhost:5433/wapply?schema=public"

# ----------------------------------------------------------
# AUTENTICAÇÃO (NextAuth / Auth.js v5)
# ----------------------------------------------------------
# Gere um segredo forte com:  npx auth secret     (ou)  openssl rand -base64 32
AUTH_SECRET="troque-isto-por-um-segredo-aleatorio-de-32-bytes"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ----------------------------------------------------------
# PROVEDORES OAUTH (opcional — arquitetura já preparada)
# Deixe em branco para manter apenas login por email/senha.
# ----------------------------------------------------------
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_APPLE_ID=""
# AUTH_APPLE_SECRET=""

# ----------------------------------------------------------
# SERVIÇO WHATSAPP (micro-serviço Baileys)
# ----------------------------------------------------------
# Provider ativo: "baileys" (padrão) ou "cloud" (Meta Cloud API — stub para o futuro)
WHATSAPP_PROVIDER="baileys"

# Porta em que o micro-serviço Baileys escuta
WHATSAPP_SERVICE_PORT="4000"

# URL que o Next.js usa para falar com o micro-serviço
WHATSAPP_SERVICE_URL="http://localhost:4000"

# URL que o micro-serviço usa para entregar eventos (webhook) de volta ao Next.js
WHATSAPP_WEBHOOK_URL="http://localhost:3000/api/whatsapp/webhook"

# Token compartilhado entre Next.js e o micro-serviço.
# Precisa ser IDÊNTICO nos dois lados — protege o webhook contra chamadas externas.
WHATSAPP_SERVICE_TOKEN="troque-este-token-interno"

# ----------------------------------------------------------
# META WHATSAPP CLOUD API (futuro — não usado no MVP)
# ----------------------------------------------------------
# META_PHONE_NUMBER_ID=""
# META_ACCESS_TOKEN=""
# META_VERIFY_TOKEN=""

# ----------------------------------------------------------
# APP
# ----------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Wapply"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
